{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": true,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "imu_frame_id": "Imu_Sensor",
    "lidar_frame_id": "vlp16",
    "base_frame_id": "",
    "odom_frame_id": "slam_odom",
    "map_frame_id": "map",
    "publish_imu2lidar": false,
    "tf_time_offset": 0.000001,
    "extension_modules": [
      "libmemory_monitor.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "imu",
    "points_topic": "lidar_0/pointcloud/filtered",
    "image_topic": "camera_0/image_raw",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data",
      "depth": 100
    },
    "image_qos": {
      "profile": "sensor_data",
      "depth": 10
    }
  }
}
