{
  "name": "space-ros-dev",
  "image": "osrf/space-ros",
  "remoteUser": "root",
  "workspaceFolder": "/home/ubuntu/space-ros-ws",
  "mounts": [
    "source=${env:HOME}/space-ros-ws,target=/home/ubuntu/space-ros-ws,type=bind",
    "source=/media/,target=/media/,type=bind"
  ],
  "runArgs": ["--gpus", "all"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "postCreateCommand": "echo 'source /opt/spaceros/install/setup.bash' >> ~/.bashrc",
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  }
}
