{
  "name": "astrobot-dev",
  "dockerComposeFile": ["../../docker-compose.lunalab.yml"],
  "service": "astrobot-dev",
  "workspaceFolder": "/workspace/astrobot-lab",
  "remoteUser": "root",

  "runArgs": ["--gpus", "all"],

  "remoteEnv": {
    "ROS_DOMAIN_ID": "177",
    "ROS_LOCALHOST_ONLY": "0",
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
    "CYCLONEDDS_URI": "file:///config/cyclonedds_config.xml"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  }
}
